shamefully-hoist=true
virtual-store-dir-max-length=70
enable-pre-post-scripts=true
# 本机安全软件（火绒内核）会拦截 NTFS Junction 的读取，
# 必须使用复制模式的 node_modules，否则 electron-builder 等工具报 UNKNOWN 错误
node-linker=hoisted


# 如果在中国网络环境中遇到 Electron 下载失败，请放开以下注释
# registry=https://registry.npmmirror.com
# electron_mirror=https://npmmirror.com/mirrors/electron/
# electron-builder-binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 然后在终端执行以下命令以确保配置生效
# pnpm install

# 如果仍然无法下载，请尝试执行以下命令
# pnpm electron-fix